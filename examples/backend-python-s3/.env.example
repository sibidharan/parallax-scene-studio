# Server
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
MAX_UPLOAD_MB=5
UPLOAD_PREFIX=parallax-scenes

# S3-compatible storage
S3_BUCKET=your-bucket
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me

# Optional for Minio, R2, Spaces, etc.
S3_ENDPOINT_URL=

# Public asset URL base. Examples:
# https://your-bucket.s3.amazonaws.com
# https://cdn.example.com
# http://localhost:9000/your-bucket
S3_PUBLIC_BASE_URL=https://your-bucket.s3.amazonaws.com

